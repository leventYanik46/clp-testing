---
import Layout from '~/layouts/Layout.astro';
import { getHomePermalink } from '~/utils/permalinks';
import type { ContentEntryMap } from "astro:content";
import { getListPage } from "~/utils/lib/contentParser.astro";
import { supportedLang } from "~/utils/lib/languageParser";
import config from '~/config/config.json';

export function getStaticPaths() {
  const paths = supportedLang.map((lang) => ({
    params: { lang: lang || undefined },
  }));
  return paths;
}

// Astro may render /404.html without any params during build. Be defensive
// and fall back to the default language or safe defaults so the 404 page
// doesn't crash the build when `Astro.params` is undefined.
const requestedLang = Astro.params?.lang;
// Let getListPage use undefined to pick the configured default language.
const lang = requestedLang ?? undefined;

let data: any[] = [];
try {
  data = await getListPage("schedule", lang as keyof ContentEntryMap | undefined);
} catch (e) {
  // If fetching content fails, swallow and continue with safe defaults below.
}

const safe = (data && data[0] && data[0].data) ? data[0].data : {
  metadata: { title: '404' },
  heading: { label: '404', code: '404' },
  messages: { primary: 'Page not found', secondary: '' },
  cta: { text: 'Home' },
};

const { metadata, heading, messages, cta } = safe;
---
<Layout metadata={metadata}>
  <section class="flex items-center h-full p-16">
    <div class="container flex flex-col items-center justify-center px-5 mx-auto my-8">
      <div class="max-w-md text-center">
        <h2 class="mb-8 font-bold text-9xl">
          <span class="sr-only">{heading.label}</span>
          <span class="text-primary">{heading.code}</span>
        </h2>
        <p class="text-3xl font-semibold md:text-3xl">{messages.primary}</p>
        <p class="mt-4 mb-8 text-lg text-muted">{messages.secondary}</p>
        <a rel="noopener noreferrer" href={getHomePermalink()} class="btn ml-4">{cta.text}</a>
      </div>
    </div>
  </section>
</Layout>
